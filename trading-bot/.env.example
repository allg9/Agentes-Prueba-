# Copia este archivo como ".env" (sin ".example") y rellena tus claves reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore) porque contiene secretos.

# Claves de tu cuenta de PAPER TRADING en Alpaca (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=tu_api_key_aqui
ALPACA_SECRET_KEY=tu_secret_key_aqui

# Símbolo de la acción a operar
SYMBOL=AAPL

# Parámetros de la estrategia (medias móviles)
SMA_CORTA=20
SMA_LARGA=50

# Parámetros de gestión de riesgo
PORCENTAJE_MAX_POR_POSICION=0.10
PERDIDA_MAX_DIARIA=0.03

# --- Agente de Noticias y Agente de Fundamentales (opcional) ---
# Sin esto configurado, el bot sigue funcionando solo con la estrategia de medias
# móviles: el bloque de noticias+fundamentales se desactiva solo, con seguridad.

# Clave gratuita de Finnhub (regístrate en https://finnhub.io/register) — nivel
# gratuito: 60 llamadas/minuto. Usada por el Agente de Fundamentales.
FINNHUB_API_KEY=

# SEC EDGAR exige identificarte con un contacto en cada petición (no requiere
# registro ni clave, solo esta cabecera). Formato: "Tu Nombre tu_email@ejemplo.com"
SEC_USER_AGENT=

# Lista de tickers a vigilar, separados por comas (por ahora el bot solo opera SYMBOL,
# pero el Agente de Noticias puede vigilar varios a la vez de cara al futuro)
WATCHLIST=AAPL
